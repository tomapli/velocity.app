# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.tmp

# Generated local DB dumps — do not commit
db/sql

.claude
.agents

# testing
/coverage

# next.js
/.next/
/out/
.next/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.pnpm-store

# env files (can opt-in for committing if needed)
.env*.local
.env
.env**
!.env.example
# Encrypted supabase env files are safe to commit (private keys stay in .env.keys)
!supabase/.env.production
!supabase/.env.preview

# vercel
.vercel

# cloudflare workers (OpenNext)
.open-next
.wrangler
.dev.vars*
!.dev.vars.example

# typescript
*.tsbuildinfo
next-env.d.ts

# git worktrees
/.worktrees/

# superpowers subagent-driven-development scratch workspace
/.superpowers/

# mise local overrides (not committed)
mise.local.toml
mise.*.local.toml

# Production data dumps — personal data, never commit
scripts/data/*_rows.sql

# Legacy CSV import — contains personal data and CSV exports
scripts/essayimport/

# Generated print sheets — regenerate on demand, don't version
scripts/output/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# VitePress
docs/.vitepress/cache
docs/.vitepress/dist
.vitepress
# Local Firecrawl documentation cache
.firecrawl/
.env*
