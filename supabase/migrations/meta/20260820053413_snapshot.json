          "withCheck": "EXISTS (\n        SELECT 1\n        FROM public.scheduled_scrapes\n        WHERE scheduled_scrapes.id = source_scrape_id\n          AND scheduled_scrapes.started_by = (SELECT auth.uid() AS uid)\n      )"
